#!/bin/sh /etc/rc.common
# Network > Cellular QoS: the queueing of the cellular link (u30pro_qos.main, see /usr/sbin/u30pro-qos; off both ways by default).  Puts
# the qdiscs in place, and for a cake with an automatic rate (bandwidth 0) runs u30pro-qosd, which finds that rate from the delay.
# Applied again after a change in UCI (procd reload trigger) and by /etc/hotplug.d/iface/40-u30pro-qos when the cellular link comes up;
# stopping gives the default qdiscs back.
START=96
USE_PROCD=1

start_service() {
	local up upk down downk delay args=
	/usr/sbin/u30pro-qos apply
	set -- $(/usr/sbin/u30pro-qos plan)
	up=$1 upk=$2 down=$3 downk=$4
	[ "$up" = cake ] && [ "$upk" = 0 ] && args="--up sipa_eth0"
	[ "$down" = cake ] && [ "$downk" = 0 ] && args="$args --down ifb-wan"
	[ -n "$args" ] || return 0
	delay=$(uci -q get u30pro_qos.main.delay)
	case "$delay" in ''|*[!0-9]*) delay=60 ;; esac
	[ "$delay" -lt 20 ] && delay=20
	[ "$delay" -gt 500 ] && delay=500
	procd_open_instance qosd
	procd_set_param command /usr/sbin/u30pro-qosd --wan sipa_eth0 $args --delay "$delay"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/sbin/u30pro-qos clear
}

service_triggers() {
	procd_add_reload_trigger u30pro_qos
}
