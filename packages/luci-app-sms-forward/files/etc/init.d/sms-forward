#!/bin/sh /etc/rc.common
# Forwards incoming SMS to the channels of /etc/config/sms_forward (Cellular > SMS forwarding); see /usr/sbin/sms-forward.
START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/sms-forward
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sms_forward
}
