#!/bin/sh
# start the forwarder (it stays idle until forwarding is switched on) and let rpcd and LuCI pick up the page
/etc/init.d/sms-forward enable 2>/dev/null
/etc/init.d/sms-forward restart 2>/dev/null
/etc/init.d/rpcd reload 2>/dev/null
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache
exit 0
