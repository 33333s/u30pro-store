{
  "luci-theme-u30pro": {
    "description": "U30 Pro theme overview page: device state and its switches",
    "read": {
      "ubus": { "u30pro-dashboard": ["state"], "u30pro-native-control": ["get"], "u30pro-wallpaper": ["get", "image"] },
      "cgi-io": ["download"],
      "file": { "/mnt/data/u30pro-wallpaper/web.live": ["read"], "/mnt/data/u30pro-wallpaper/wallpaper.live": ["read"] }
    },
    "write": { "ubus": { "u30pro-dashboard": ["nfc_set"], "u30pro-native-control": ["wifi_toggle", "set_screen_power", "cellular_action"] } }
  }
}
